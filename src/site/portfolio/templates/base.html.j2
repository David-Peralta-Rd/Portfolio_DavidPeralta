<!doctype html><html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="static/style.css">
<title>{% block title %}{{ profile.name }}{% endblock %}</title>
</head>
<body>
<header class="site-header">
  <div class="wrap">
    <div class="bar">
      <a class="brand" href="#inicio" aria-label="{{ profile.name }}, inicio">
        <span class="mark sq">{{ profile.initials }}</span>
        <span>{{ profile.name }}</span>
      </a>
      <div class="tools">
        <nav class="links" aria-label="Secciones">
          <a class="sq" href="#proyectos">Proyectos</a>
          <a class="sq" href="#stack">Stack</a>
          <a class="sq" href="#sobre-mi">Sobre mí</a>
          <a class="sq keep" href="#contacto">Contacto</a>
        </nav>
        <button class="theme-btn sq" id="theme" type="button" aria-label="Cambiar entre tema claro y oscuro">
          <svg id="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
          <svg id="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"/></svg>
        </button>
      </div>
    </div>
  </div>
</header>
<main>{% block main %}{% endblock %}</main>
<footer>
  <div class="wrap">
    <div class="foot">
      <span>© {{ profile.site_year }} {{ profile.name }}</span>
      <span>{{ profile.footer_note }}</span>
    </div>
  </div>
</footer>
<script src="static/main.js" defer></script>
</body>
</html>